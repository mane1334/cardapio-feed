# Copia para .env (ou define no servidor). Nunca commits o .env real.
PORT=3001
HOST=0.0.0.0
# Pasta onde ficam db.json, media/ e backups/ (usa um volume persistente em produção)
DATA_DIR=./storage
# Em produção: off. Em desenvolvimento cria o restaurante demo (dono@kutsakai.mz / kutsakai123)
DEMO_MODE=off
# off = fecha os registos novos
REGISTRATION=on
# 1 quando estiveres atrás de Caddy/Nginx/Cloudflare (usa X-Forwarded-For para o IP)
TRUST_PROXY=1
# Fuso horário em minutos face a UTC (Maputo = 120)
TZ_OFFSET_MIN=120
SESSION_DAYS=7

# Usado só pelo docker-compose
DOMAIN=cardapio.teudominio.co.mz

# Cloudflare R2 (Persistência 100% gratuita na nuvem para fotos e db.json)
# Obtenha em: Cloudflare Dashboard -> R2 Object Storage -> Manage R2 API Tokens
# R2_ACCOUNT_ID=seu_account_id_de_32_caracteres
# R2_ACCESS_KEY_ID=sua_access_key_id
# R2_SECRET_ACCESS_KEY=sua_secret_access_key
# R2_BUCKET=cardapio-feed
# R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
